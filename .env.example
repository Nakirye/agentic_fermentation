# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
FERMENTATION_MODEL=gpt-4.1-mini

# Optional: any server with an OpenAI-compatible Responses API, e.g. Ollama.
# The API key is then not needed; set FERMENTATION_MODEL to a local model (e.g. qwen3:14b).
# OPENAI_BASE_URL=http://localhost:11434/v1
